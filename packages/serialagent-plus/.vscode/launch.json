{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Serial Agent Plus Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/serialagent-plus"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/serialagent-plus/dist/**/*.js"
      ],
      "preLaunchTask": "npm: build - packages/serialagent-plus"
    }
  ]
}
