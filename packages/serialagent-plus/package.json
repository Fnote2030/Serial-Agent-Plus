{
  "name": "serialagent-plus",
  "displayName": "Serial Agent Plus",
  "description": "Serial monitor and MCP bridge for embedded debugging in VS Code. Unofficial fork of Rance-OwO/Serial-Agent focused on enhanced serial features.",
  "version": "1.2.1",
  "publisher": "Fnote2030",
  "license": "MIT",
  "icon": "media/SerialAgentPlus.png",
  "homepage": "https://github.com/Fnote2030/Serial-Agent-Plus",
  "bugs": {
    "url": "https://github.com/Fnote2030/Serial-Agent-Plus/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "serial",
    "uart",
    "embedded",
    "stm32",
    "mcp",
    "debug",
    "monitor"
  ],
  "categories": [
    "Debuggers",
    "Other"
  ],
  "qna": false,
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serialagent-plus",
          "title": "Serial Agent Plus",
          "icon": "media/SerialAgentPlus_icon.svg"
        }
      ]
    },
    "views": {
      "serialagent-plus": [
        {
          "type": "webview",
          "id": "serialagent-plus.serialPanel",
          "name": "Serial Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "serialagent.refreshPorts",
        "title": "Refresh Serial Ports",
        "category": "Serial Agent Plus",
        "icon": "$(refresh)"
      },
      {
        "command": "serialagent.disconnect",
        "title": "Disconnect Serial Port",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.clearLog",
        "title": "Clear Serial Log",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.toggleConnection",
        "title": "Toggle Serial Connection",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.toggleBridge",
        "title": "Toggle MCP Bridge Server",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openInTab",
        "title": "Open Serial Agent Plus",
        "category": "Serial Agent Plus",
        "icon": {
          "light": "media/SerialAgentPlus.svg",
          "dark": "media/SerialAgentPlus.svg"
        }
      }
    ],
    "configuration": {
      "title": "Serial Agent Plus",
      "properties": {
        "serialagent.portAutoRefresh": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Automatically refresh the serial port list while the Serial Agent Plus panel is visible."
        },
        "serialagent.portRefreshIntervalMs": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "maximum": 30000,
          "scope": "machine",
          "markdownDescription": "Polling interval in milliseconds when port auto-refresh is enabled and the panel is visible."
        },
        "serialagent.portRefreshMetadataIntervalMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "scope": "machine",
          "markdownDescription": "On Windows, how often to refresh friendly port names via PowerShell. Port add/remove is still detected at the faster polling interval."
        }
      }
    },
    "keybindings": [],
    "menus": {
      "editor/title": [
        {
          "command": "serialagent.openInTab",
          "group": "navigation",
          "when": "true"
        }
      ],
      "view/title": [
        {
          "command": "serialagent.openInTab",
          "group": "navigation",
          "when": "view == serialagent-plus.serialPanel"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --config webpack.config.js",
    "build": "webpack --config webpack.config.js",
    "pack": "node pack.js",
    "clean": "rimraf dist",
    "watch": "tsc -p tsconfig.json -w"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "iconv-lite": "^0.7.2",
    "serialport": "^12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fnote2030/Serial-Agent-Plus"
  },
  "vsce": {
    "baseContentUrl": "https://github.com/Fnote2030/Serial-Agent-Plus/blob/main/packages/serialagent-plus/",
    "baseImagesUrl": "https://raw.githubusercontent.com/Fnote2030/Serial-Agent-Plus/main/packages/serialagent-plus/"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/vscode": "^1.85.0",
    "@vercel/ncc": "^0.38.4",
    "node-loader": "^2.1.0",
    "rimraf": "^5.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.5.0",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}
