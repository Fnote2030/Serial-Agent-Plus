{
  "name": "serialagent-plus",
  "displayName": "Serial Agent Plus",
  "description": "Serial monitor and MCP bridge for embedded debugging in VS Code. Unofficial fork of Rance-OwO/Serial-Agent focused on enhanced serial features.",
  "version": "1.2.1",
  "publisher": "Fnote2030",
  "license": "MIT",
  "icon": "media/SerialAgentPlus.png",
  "homepage": "https://github.com/Fnote2030/Serial-Agent-Plus",
  "bugs": {
    "url": "https://github.com/Fnote2030/Serial-Agent-Plus/issues"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "keywords": [
    "serial",
    "uart",
    "embedded",
    "stm32",
    "mcp",
    "debug",
    "monitor"
  ],
  "categories": [
    "Debuggers",
    "Other"
  ],
  "qna": false,
  "extensionKind": [
    "ui"
  ],
  "capabilities": {
    "virtualWorkspaces": false,
    "untrustedWorkspaces": {
      "supported": false
    }
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "serialagent-plus",
          "title": "Serial Agent Plus",
          "icon": "media/SerialAgentPlus_icon.svg"
        }
      ]
    },
    "views": {
      "serialagent-plus": [
        {
          "type": "webview",
          "id": "serialagent-plus.serialPanel",
          "name": "Serial Monitor"
        }
      ]
    },
    "commands": [
      {
        "command": "serialagent.refreshPorts",
        "title": "Refresh Serial Ports",
        "category": "Serial Agent Plus",
        "icon": "$(refresh)"
      },
      {
        "command": "serialagent.disconnect",
        "title": "Disconnect Serial Port",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.clearLog",
        "title": "Clear Serial Log",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.toggleConnection",
        "title": "Toggle Serial Connection",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.toggleBridge",
        "title": "Toggle MCP Bridge Server",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openInTab",
        "title": "Select Serial Monitor...",
        "category": "Serial Agent Plus",
        "icon": "$(circuit-board)"
      },
      {
        "command": "serialagent.openMonitor1",
        "title": "Monitor 1",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor2",
        "title": "Monitor 2",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor3",
        "title": "Monitor 3",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor4",
        "title": "Monitor 4",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor5",
        "title": "Monitor 5",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor6",
        "title": "Monitor 6",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor7",
        "title": "Monitor 7",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor8",
        "title": "Monitor 8",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor9",
        "title": "Monitor 9",
        "category": "Serial Agent Plus"
      },
      {
        "command": "serialagent.openMonitor10",
        "title": "Monitor 10",
        "category": "Serial Agent Plus"
      }
    ],
    "configuration": {
      "title": "Serial Agent Plus",
      "properties": {
        "serialagent.portAutoRefresh": {
          "type": "boolean",
          "default": true,
          "scope": "machine",
          "markdownDescription": "Automatically refresh the serial port list while the Serial Agent Plus panel is visible."
        },
        "serialagent.portRefreshIntervalMs": {
          "type": "number",
          "default": 3000,
          "minimum": 1000,
          "maximum": 30000,
          "scope": "machine",
          "markdownDescription": "Polling interval in milliseconds when port auto-refresh is enabled and the panel is visible."
        },
        "serialagent.portRefreshMetadataIntervalMs": {
          "type": "number",
          "default": 30000,
          "minimum": 5000,
          "scope": "machine",
          "markdownDescription": "On Windows, how often to refresh friendly port names via PowerShell. Port add/remove is still detected at the faster polling interval."
        },
        "serialagent.logBufferKB": {
          "type": "number",
          "default": 1024,
          "minimum": 1,
          "maximum": 10240,
          "scope": "machine",
          "markdownDescription": "Log buffer cap in KB (total UTF-8 bytes, oldest lines dropped first). Shared by the log view and the extension log buffer used by Save Log / MCP `read_serial_log`."
        },
        "serialagent.monitorOpenTarget": {
          "type": "string",
          "default": "active",
          "enum": ["active", "beside"],
          "scope": "machine",
          "markdownDescription": "Where a Serial Monitor opens in the editor area: `active` reuses the current editor group, `beside` opens a new group to the right."
        }
      }
    },
    "keybindings": [],
    "submenus": [
      {
        "id": "serialagent.openMonitorMenu",
        "label": "Serial Monitor",
        "icon": "$(circuit-board)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "submenu": "serialagent.openMonitorMenu",
          "group": "navigation",
          "when": "config.workbench.editor.editorActionsLocation != 'titleBar' && config.workbench.editor.showTabs != 'none'"
        }
      ],
      "serialagent.openMonitorMenu": [
        { "command": "serialagent.openMonitor1", "when": "serialagent.monitor1", "group": "monitors@1" },
        { "command": "serialagent.openMonitor2", "when": "serialagent.monitor2", "group": "monitors@2" },
        { "command": "serialagent.openMonitor3", "when": "serialagent.monitor3", "group": "monitors@3" },
        { "command": "serialagent.openMonitor4", "when": "serialagent.monitor4", "group": "monitors@4" },
        { "command": "serialagent.openMonitor5", "when": "serialagent.monitor5", "group": "monitors@5" },
        { "command": "serialagent.openMonitor6", "when": "serialagent.monitor6", "group": "monitors@6" },
        { "command": "serialagent.openMonitor7", "when": "serialagent.monitor7", "group": "monitors@7" },
        { "command": "serialagent.openMonitor8", "when": "serialagent.monitor8", "group": "monitors@8" },
        { "command": "serialagent.openMonitor9", "when": "serialagent.monitor9", "group": "monitors@9" },
        { "command": "serialagent.openMonitor10", "when": "serialagent.monitor10", "group": "monitors@10" },
        { "command": "serialagent.openInTab", "group": "select@1" }
      ],
      "commandPalette": [
        { "command": "serialagent.openMonitor1", "when": "false" },
        { "command": "serialagent.openMonitor2", "when": "false" },
        { "command": "serialagent.openMonitor3", "when": "false" },
        { "command": "serialagent.openMonitor4", "when": "false" },
        { "command": "serialagent.openMonitor5", "when": "false" },
        { "command": "serialagent.openMonitor6", "when": "false" },
        { "command": "serialagent.openMonitor7", "when": "false" },
        { "command": "serialagent.openMonitor8", "when": "false" },
        { "command": "serialagent.openMonitor9", "when": "false" },
        { "command": "serialagent.openMonitor10", "when": "false" },
        { "command": "serialagent.addMonitor", "when": "false" }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "webpack --config webpack.config.js",
    "build": "webpack --config webpack.config.js",
    "pack": "node pack.js",
    "clean": "rimraf dist",
    "watch": "tsc -p tsconfig.json -w"
  },
  "dependencies": {
    "@vscode/codicons": "^0.0.36",
    "iconv-lite": "^0.7.2",
    "serialport": "^12.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Fnote2030/Serial-Agent-Plus"
  },
  "vsce": {
    "baseContentUrl": "https://github.com/Fnote2030/Serial-Agent-Plus/blob/main/packages/serialagent-plus/",
    "baseImagesUrl": "https://raw.githubusercontent.com/Fnote2030/Serial-Agent-Plus/main/packages/serialagent-plus/"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "@types/vscode": "^1.85.0",
    "@vercel/ncc": "^0.38.4",
    "node-loader": "^2.1.0",
    "rimraf": "^5.0.0",
    "ts-loader": "^9.5.4",
    "typescript": "^5.5.0",
    "webpack": "^5.105.3",
    "webpack-cli": "^6.0.1"
  }
}
