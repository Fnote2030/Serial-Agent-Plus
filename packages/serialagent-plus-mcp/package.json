{
  "name": "@fnote2030/serialagent-plus-mcp",
  "version": "1.1.0",
  "description": "MCP server for Serial Agent Plus (unofficial fork of Rance-OwO/Serial-Agent). Requires the Serial Agent Plus VS Code extension and local Bridge.",
  "author": "Fnote2030",
  "license": "MIT",
  "main": "./dist/index.js",
  "bin": {
    "serialagent-plus-mcp": "dist/index.js"
  },
  "homepage": "https://github.com/Fnote2030/Serial-Agent-Plus",
  "bugs": {
    "url": "https://github.com/Fnote2030/Serial-Agent-Plus/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fnote2030/Serial-Agent-Plus.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "README_EN.md"
  ],
  "keywords": [
    "mcp",
    "serial",
    "embedded",
    "vscode",
    "serial-agent-plus",
    "stm32",
    "bridge"
  ],
  "scripts": {
    "build": "rimraf dist && tsc && node ./scripts/postbuild-versioned.cjs",
    "clean": "rimraf dist",
    "watch": "tsc -w",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "@types/node": "^20.0.0",
    "rimraf": "^5.0.0"
  }
}
