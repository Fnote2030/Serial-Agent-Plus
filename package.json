{
  "name": "serial-agent-plus",
  "version": "1.1.0",
  "private": true,
  "description": "Serial Agent Plus monorepo - VS Code extension, MCP server, and skill source. Unofficial fork of Rance-OwO/Serial-Agent with enhanced serial features.",
  "repository": {
    "type": "git",
    "url": "https://github.com/Fnote2030/Serial-Agent-Plus"
  },
  "workspaces": [
    "packages/serialagent-plus-mcp",
    "packages/serialagent-plus"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "clean": "npm run clean --workspaces --if-present",
    "watch": "npm run watch --workspaces --if-present",
    "bridge:build": "tsc -p tsconfig.bridge.json",
    "bridge": "npm run bridge:build && node dist-bridge/tests/test-bridge-real-hw.js",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "author": "",
  "license": "MIT",
  "devDependencies": {
    "@vitest/coverage-v8": "^4.0.18",
    "vitest": "^4.0.18"
  }
}
